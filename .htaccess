# Yoga 1 Hour — canonical clean URLs
Options -MultiViews
RewriteEngine On

# Canonical host (enable only if the production host should always be non-www)
RewriteCond %{HTTP_HOST} ^www\.yoga1hour\.com$ [NC]
RewriteRule ^(.*)$ https://yoga1hour.com/$1 [R=301,L]

# Legacy .html URLs -> clean URLs
RewriteRule ^index\.html$ / [R=301,L,NE]
RewriteRule ^about\.html$ /about/ [R=301,L,NE]
RewriteRule ^home-yoga\.html$ /private-yoga-classes-at-home-bangalore/ [R=301,L,NE]
RewriteRule ^school-yoga\.html$ /yoga-for-school-children-bangalore/ [R=301,L,NE]
RewriteRule ^corporate-yoga\.html$ /corporate-yoga-classes-bangalore/ [R=301,L,NE]
RewriteRule ^classes\.html$ /classes/ [R=301,L,NE]
RewriteRule ^contact\.html$ /contact/ [R=301,L,NE]
RewriteRule ^blog\.html$ /blog/ [R=301,L,NE]
RewriteRule ^blog-how-to-make-one-hour-matter\.html$ /blog/how-to-make-one-hour-matter/ [R=301,L,NE]
RewriteRule ^blog-simple-reset-between-meetings\.html$ /blog/simple-reset-between-meetings/ [R=301,L,NE]
RewriteRule ^blog-value-of-private-practice\.html$ /blog/value-of-private-practice/ [R=301,L,NE]

# Directory URLs are served by their index.html without exposing the filename.
DirectoryIndex index.html
